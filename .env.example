APP_NAME=NexamPay
APP_ENV=production
DEBUG=false

SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_SECRET_KEY=replace_with_a_different_random_secret_at_least_32_characters

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME

TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_BOT_USERNAME=replace_with_your_bot_username

ADMIN_TELEGRAM_ID=replace_with_your_telegram_numeric_id

MOBILE_FUSION_API_URL=
MOBILE_FUSION_API_KEY=
MOBILE_FUSION_SECRET_KEY=

DEFAULT_TRANSACTION_TIMEOUT_SECONDS=900
FEE_FREE_LIMIT=1500
FEE_PERCENT=5
MIN_TRANSACTION_AMOUNT=1
MAX_TRANSACTION_AMOUNT=100000000
CORS_ORIGINS=
ADMIN_ACCESS_CODE=replace_with_a_strong_private_admin_code

